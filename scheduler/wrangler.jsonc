{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rankcues-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "services": [
    {
      "binding": "RANKCUES",
      "service": "rankcues-preview"
    }
  ],
  "triggers": {
    "crons": [
      "*/2 * * * *",
      "0 3 * * *",
      "0 4 * * 1"
    ]
  },
  "observability": {
    "enabled": true
  }
}
