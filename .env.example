# Google OAuth / Search Console / GA4
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Encrypts OAuth access and refresh tokens before database storage.
# Generate a long random value, for example: openssl rand -base64 32
APP_ENCRYPTION_KEY=
DEFAULT_WORKSPACE_ID=default

# GitHub App used for repository-scoped Draft Pull Requests.
# Register one platform-owned app; customers only install it and never enter tokens.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_STATE_SECRET=

# AI inference. Supports OpenAI directly or any OpenAI-compatible relay.
# Keep these values server-side. Do not expose them through NEXT_PUBLIC_*.
AI_PROVIDER_NAME=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_SUPPORTS_STRUCTURED_OUTPUTS=false
AI_CUSTOM_HEADERS_JSON={}

# Backwards-compatible fallback; AI_API_KEY takes precedence.
OPENAI_API_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_OPERATOR=
STRIPE_PRICE_ID_AGENCY=

# Database / queue
DATABASE_URL=
DATABASE_SSL=
DATABASE_POOL_SIZE=4
REDIS_URL=

# Scheduled data collection and reporting
CRON_SECRET=
CRON_SITE_LIMIT=10
WEEKLY_REPORT_SITE_LIMIT=10
GSC_MAX_ROWS_PER_SYNC=50000
GSC_DAILY_MAX_ROWS_PER_SYNC=25000
CRAWL_ON_DAILY_SYNC=true
CRAWL_MAX_PAGES=20

# Controlled link campaigns. Paused: not part of the current product surface.
# Set to true only to reopen /app/link-campaigns for internal testing.
LINK_CAMPAIGNS_ENABLED=false
LINK_CAMPAIGNS_DEFAULT_ENABLED=false
LINK_CAMPAIGNS_AUTO_MIGRATE=false
LINK_AUTO_EXECUTION_ENABLED=false
LINK_MAX_BATCH_SIZE=30

# Optional keyword data provider
SEMRUSH_API_KEY=
